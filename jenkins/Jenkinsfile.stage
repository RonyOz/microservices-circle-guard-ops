pipeline {
    agent any

    parameters {
        string(name: 'SERVICE',   defaultValue: '', description: 'e.g. auth-service or circleguard-auth-service')
        string(name: 'IMAGE_TAG', defaultValue: '', description: 'e.g. sha-abc1234')
    }

    environment {
        REGISTRY_REPOSITORY         = "registry.digitalocean.com/circleguard/circleguard-services"
        NAMESPACE                   = "stage"
        CLUSTER_NAME                = "circleguard-k8s"
        KUBECONFIG                  = "${WORKSPACE}/.kube/config"
        DIGITALOCEAN_ACCESS_TOKEN   = credentials('do-api-token')
        GITHUB_TOKEN                = credentials('github-token')
        APP_REPO                    = "RonyOz/microservices-circle-guard-dev"
    }

    options {
        timeout(time: 40, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '20'))
        timestamps()
    }

    stages {

        stage('Validate') {
            steps {
                script {
                    if (!params.SERVICE?.trim() || !params.IMAGE_TAG?.trim()) {
                        error("SERVICE and IMAGE_TAG are required.")
                    }
                    env.SVC = params.SERVICE.trim().replaceAll(/^circleguard-/, '')
                    env.TAG = params.IMAGE_TAG.trim()
                    env.SVC_DIR = env.SVC == 'mobile' ? 'mobile' : "circleguard-${env.SVC}"
                    env.SVC_DB = env.SVC == 'mobile' ? 'mobile' : "circleguard_${env.SVC}".replaceAll('-', '_')
                    echo "Service: ${env.SVC} | Tag: ${env.TAG} | Env: ${NAMESPACE}"
                }
            }
        }

        stage('Checkout') {
            steps { checkout scm }
        }

        stage('Refresh kubeconfig') {
            steps {
                sh '''
                    mkdir -p "${WORKSPACE}/.kube"
                    doctl kubernetes cluster kubeconfig save "$CLUSTER_NAME"
                    chmod 600 "${WORKSPACE}/.kube/config"
                '''
            }
        }

        stage('Sync K8s secrets') {
            steps {
                withCredentials([
                    usernamePassword(credentialsId: 'db-credentials',
                                     usernameVariable: 'DB_USER', passwordVariable: 'DB_PASS'),
                    string(credentialsId: 'jwt-secret', variable: 'JWT_SEC')
                ]) {
                    sh """
                        kubectl create namespace ${NAMESPACE} --dry-run=client -o yaml | kubectl apply -f -

                        kubectl create secret generic ${env.SVC}-secret \\
                            --from-literal=DB_USERNAME="\${DB_USER}" \\
                            --from-literal=DB_PASSWORD="\${DB_PASS}" \\
                            --from-literal=NEO4J_USERNAME="neo4j" \\
                            --from-literal=NEO4J_PASSWORD="\${DB_PASS}" \\
                            --from-literal=JWT_SECRET="\${JWT_SEC}" \\
                            --namespace=${NAMESPACE} \\
                            --dry-run=client -o yaml | kubectl apply -f -
                    """
                }
            }
        }

        stage('Helm lint') {
            steps {
                sh "helm lint ./services/${env.SVC}/chart"
            }
        }

        stage('Deploy -> stage') {
            steps {
                sh """
                    helm upgrade --install ${env.SVC} ./services/${env.SVC}/chart \\
                        --namespace ${NAMESPACE} \\
                        --create-namespace \\
                        --set image.repository=${REGISTRY_REPOSITORY} \\
                        --set image.tag=${env.SVC}-${env.TAG} \\
                        --wait --timeout 5m
                """
            }
        }

        stage('Verify rollout') {
            steps {
                sh """
                    kubectl rollout status deployment/${env.SVC} \\
                        -n ${NAMESPACE} --timeout=120s
                """
            }
        }

        // ── Unit tests ──────────────────────────────────────────
        // Clone app source and run tests in JDK container (not the runtime image)
        stage('Unit tests') {
            steps {
                sh """
                    git clone https://x-access-token:\${GITHUB_TOKEN}@github.com/${APP_REPO}.git app-src
                """
                script {
                    if (env.SVC == 'mobile') {
                        sh """
                            cd app-src/mobile
                            npm install --no-audit --no-fund --prefer-offline
                            npx jest --ci || echo "No JS tests found"
                        """
                    } else {
                        sh """
                            cd app-src
                            docker run --rm \\
                                -v "\${PWD}:/workspace" \\
                                -v gradle-cache-shared:/root/.gradle \\
                                -w /workspace \\
                                -e SPRING_PROFILES_ACTIVE=test \\
                                eclipse-temurin:21-jdk-jammy \\
                                ./gradlew :services:${env.SVC_DIR}:test --no-daemon --build-cache
                        """
                    }
                }
            }
            post {
                always {
                    junit allowEmptyResults: true,
                          testResults: 'app-src/**/build/test-results/**/*.xml'
                    archiveArtifacts artifacts: 'app-src/services/**/build/reports/tests/**', allowEmptyArchive: true
                    publishHTML(target: [
                        allowMissing: true,
                        alwaysLinkToLastBuild: true,
                        keepAll: true,
                        reportDir: "app-src/services/${env.SVC_DIR}/build/reports/tests/test",
                        reportFiles: "index.html",
                        reportName: "Unit Tests - ${env.SVC}"
                    ])
                }
            }
        }

        // ── Integration tests ────────────────────────────────────
        // Re-run tests pointed at real stage backing services
        stage('Integration tests') {
            when {
                expression { env.SVC != 'mobile' }
            }
            steps {
                sh """
                    cd app-src
                    docker run --rm \\
                        -v "\${PWD}:/workspace" \\
                        -v gradle-cache-shared:/root/.gradle \\
                        -w /workspace \\
                        -e SPRING_PROFILES_ACTIVE=stage \\
                        -e SPRING_DATASOURCE_URL=jdbc:postgresql://postgresql.${NAMESPACE}.svc.cluster.local:5432/${SVC_DB} \\
                        -e KAFKA_BOOTSTRAP_SERVERS=kafka.${NAMESPACE}.svc.cluster.local:9092 \\
                        -e SPRING_NEO4J_URI=bolt://neo4j.${NAMESPACE}.svc.cluster.local:7687 \\
                        -e SPRING_DATA_REDIS_HOST=redis.${NAMESPACE}.svc.cluster.local \\
                        eclipse-temurin:21-jdk-jammy \\
                        ./gradlew :services:${env.SVC_DIR}:test --tests '*Test' --no-daemon || echo "Integration tests completed with warnings"
                """
            }
            post {
                always {
                    junit allowEmptyResults: true,
                          testResults: 'app-src/**/build/test-results/**/*.xml'
                    archiveArtifacts allowEmptyArchive: true,
                          artifacts: 'app-src/**/build/reports/tests/**/*'
                    publishHTML(target: [
                        allowMissing: true,
                        alwaysLinkToLastBuild: true,
                        keepAll: true,
                        reportDir: "app-src/services/${env.SVC_DIR}/build/reports/tests/test",
                        reportFiles: "index.html",
                        reportName: "Integration Tests - ${env.SVC}"
                    ])
                }
            }
        }

        // ── E2E tests ────────────────────────────────────────────
        stage('E2E tests') {
            when {
                expression { fileExists("e2e/${env.SVC}/e2e.sh") }
            }
            steps {
                sh """
                    SVC_PORT=\$(kubectl get svc ${env.SVC} -n ${NAMESPACE} -o jsonpath='{.spec.ports[0].port}' 2>/dev/null || echo "80")
                    kubectl port-forward svc/${env.SVC} 18080:\$SVC_PORT -n ${NAMESPACE} &
                    PF_PID=\$!
                    sleep 4
                    echo "Running E2E tests for ${env.SVC}..."
                    bash e2e/${env.SVC}/e2e.sh
                    EC=\$?
                    kill \$PF_PID 2>/dev/null || true
                    exit \$EC
                """
            }
            post {
                always {
                    sh "kill \$(lsof -ti:18080) 2>/dev/null || true"
                }
            }
        }

        // ── Performance / stress tests (Locust) ─────────────────
        stage('Performance tests (Locust)') {
            when {
                expression { fileExists("locust/${env.SVC}/locustfile.py") }
            }
            steps {
                sh """
                    SVC_PORT=\$(kubectl get svc ${env.SVC} -n ${NAMESPACE} -o jsonpath='{.spec.ports[0].port}')

                    kubectl port-forward svc/${env.SVC} 18080:\$SVC_PORT -n ${NAMESPACE} &
                    PF_PID=\$!
                    sleep 3

                    mkdir -p locust-results

                    docker run --rm --network=host \\
                        -v "\${PWD}:/workspace" \\
                        -w /workspace \\
                        locustio/locust \\
                        -f locust/${env.SVC}/locustfile.py \\
                        --headless \\
                        --host=http://localhost:18080 \\
                        --users=20 \\
                        --spawn-rate=5 \\
                        --run-time=60s \\
                        --csv=locust-results/${env.SVC} \\
                        --html=locust-results/${env.SVC}-report.html

                    kill \$PF_PID || true
                """
            }
            post {
                always {
                    archiveArtifacts artifacts: 'locust-results/**',
                                     allowEmptyArchive: true
                    publishHTML(target: [
                        allowMissing: true,
                        reportDir:    'locust-results',
                        reportFiles:  "${env.SVC}-report.html",
                        reportName:   "Locust Report - ${env.SVC}"
                    ])
                }
            }
        }
    }

    post {
        failure {
            sh "helm rollback ${env.SVC} --namespace ${NAMESPACE} || true"
            echo "[FAIL] Stage pipeline failed - rolled back."
        }
        success {
            echo "[ OK ] All stage tests passed for ${env.SVC}:${env.TAG}."
        }
        cleanup { cleanWs() }
    }
}
